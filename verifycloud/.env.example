# Copy to .env and replace every value marked CHANGE ME. Never commit .env.
# Generate passwords and tokens with:  openssl rand -hex 32
# (hex: base64 output contains / + = which break DATABASE_URL)
# SECRET_ENCRYPTION_KEY is the exception: it must be base64 of 32 bytes (openssl rand -base64 32)

POSTGRES_PASSWORD=CHANGE-ME-postgres
S3_ACCESS_KEY_ID=verifycloud
S3_SECRET_ACCESS_KEY=CHANGE-ME-minio-secret
S3_BUCKET=verifycloud
S3_REGION=us-east-1

# 32 random bytes, base64 — encrypts project secrets at rest. Losing it makes stored secrets unreadable.
SECRET_ENCRYPTION_KEY=CHANGE-ME-base64-32-bytes
# shared secret workers present once to register (long random value)
WORKER_REGISTRATION_TOKEN=CHANGE-ME-long-random-worker-token

# development (local compose) or production (enforces HTTPS + secure settings at startup)
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
# true behind HTTPS (required when NODE_ENV=production)
COOKIE_SECURE=false
LOG_LEVEL=info

# Seeded demo project (synthetic AXI4-Lite design with one intentional bug)
DEMO_SEED=true
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=CHANGE-ME-demo-password
DEMO_PATCH_FILE=/app/examples/axi4lite-demo/fix-rdata-stable.patch
# Public demo: anonymous visitors get a 2-hour account limited to the demo project
PUBLIC_DEMO=false
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false

# Email (unset: messages are logged instead of sent)
SMTP_URL=
MAIL_FROM=VerifyCloud <no-reply@localhost>

# GitHub App (optional) — see docs/github-integration.md
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# AI failure analysis (optional). Without these the rule-based analyzer is used.
AI_OPENAI_BASE_URL=
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=llama3.1

# Metrics endpoint protection (unset: /metrics only from loopback)
METRICS_TOKEN=

# Worker
WORKER_CPUS=4
WORKER_MEMORY_MB=8192
# optional OCI runtime for sandboxes, e.g. runsc (gVisor) if installed on the worker host
SANDBOX_RUNTIME=
